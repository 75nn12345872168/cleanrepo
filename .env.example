# Optional: Set a Formspree (https://formspree.io/f/your-id) or Web3Forms endpoint.
# If left empty, the intake form works out-of-the-box via structured mailto + one-click clipboard copy.
VITE_FORM_ENDPOINT=

# Optional: Web3Forms access key (only used if VITE_FORM_ENDPOINT points to https://api.web3forms.com/submit)
VITE_WEB3FORMS_KEY=

# Contact email displayed in footer and used for mailto fallback
VITE_CONTACT_EMAIL=gibrel@cleanrepo.dev
